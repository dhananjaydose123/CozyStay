<style>
  .search-bar {
    width: 30rem;
  }
  .search-inp {
    padding: 0.5rem 3rem 0.5rem 3rem;
    border-radius: 25px;
  }
  .search-btn {
    border-radius: 25px;
    padding: 0 1.5rem 0 1.5rem;
    background-color: #fe424d;
    color: white;
  }
  .search-btn:hover {
    background-color: #fe424d;
    color: white;
  }
</style>

<nav class="navbar navbar-expand-md bg-body-tertiary border-bottom sticky-top">
  <div class="container-fluid">
    <a class="navbar-brand" href="/listings"
      ><i class="fa-regular fa-compass"></i
    ></a>
    <button
      class="navbar-toggler"
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#navbarNavAltMarkup"
      aria-controls="navbarNavAltMarkup"
      aria-expanded="false"
      aria-label="Toggle navigation"
    >
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
      <div class="navbar-nav">
        <a class="nav-link" href="/listings"> CozyStay</a>
      </div>
      <div class="ms-auto search-bar">
        <form class="d-flex" role="search">
          <input
            class="form-control me-2 search-inp"
            type="search"
            placeholder="Search destinstions"
            aria-label="Search"
          />
          <button class="btn search-btn" type="submit">Search</button>
        </form>
      </div>
      <div class="navbar-nav ms-auto">
        <a class="nav-link" href="/listings/new">Add new Listing</a>
        <% if(!locals.currentUser){ %>
        <a class="nav-link" aria-current="page" href="/login"><b>Login</b></a>
        <a class="nav-link" href="/signup"><b>SignUp</b></a>
        <% } else { %>
        <a class="nav-link" aria-current="page" href="/logout"
          ><b>Log out</b></a
        >
        <% }%>
      </div>
    </div>
  </div>
</nav>
