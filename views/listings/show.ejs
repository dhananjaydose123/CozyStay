<% layout("layouts/boilerplate") %>

<body>
  <div class="container mt-3">
    <div class="row justify-content-center">
      <div class="col-lg-8">
        <h2 class="mb-3"><b><%= list.title %></b></h2>
        <div class="card show-card">
          <img
            src="<%= list.image.url %>"
            class="card-img-top object-fit-cover"
            style="aspect-ratio: 16/10"
            alt="<%= list.title %>"
          />
          <div class="card-body">
            <p class="card-text mb-1">
              Owned by: <i><%= list.owner.username %></i>
            </p>
            <p class="card-text"><%= list.location %>, <%= list.country %></p>
            <p class="card-text"><%= list.description %></p>
            <p class="card-text fw-semibold">
              &#8377; <%= list.price.toLocaleString("en-IN")%>
            </p>
          </div>
        </div>

        <% if (typeof currentUser !== 'undefined' && currentUser &&
        String(currentUser._id) === String(list.owner._id)) { %>
        <div class="d-flex gap-2 my-3">
          <a class="btn btn-dark" href="/listings/<%= list._id %>/edit">Edit</a>
          <form method="post" action="/listings/<%= list._id %>?_method=DELETE">
            <button class="btn btn-outline-dark">Delete</button>
          </form>
        </div>
        <% } %>

        <hr />
        <!-- Reviews section -->
        <% if (typeof currentUser !== 'undefined' && currentUser) { %>

        <h3 id="reviews">Leave a Review</h3>
        <form
          method="post"
          action="/listings/<%= list._id %>/reviews"
          novalidate
          class="needs-validation"
        >
          <div class="mb-3 mt-3">
            <label for="rating" class="form-label">Rating</label>
            <fieldset class="starability-heartbeat">
              <input
                type="radio"
                id="no-rate"
                class="input-no-rate"
                name="review[rating]"
                value="1"
                checked
                aria-label="No rating."
              />
              <input
                type="radio"
                id="first-rate1"
                name="review[rating]"
                value="1"
              />
              <label for="first-rate1" title="Terrible">1 star</label>
              <input
                type="radio"
                id="first-rate2"
                name="review[rating]"
                value="2"
              />
              <label for="first-rate2" title="Not good">2 stars</label>
              <input
                type="radio"
                id="first-rate3"
                name="review[rating]"
                value="3"
              />
              <label for="first-rate3" title="Average">3 stars</label>
              <input
                type="radio"
                id="first-rate4"
                name="review[rating]"
                value="4"
              />
              <label for="first-rate4" title="Very good">4 stars</label>
              <input
                type="radio"
                id="first-rate5"
                name="review[rating]"
                value="5"
              />
              <label for="first-rate5" title="Amazing">5 stars</label>
            </fieldset>
          </div>
          <div class="mb-3 mt-3">
            <label for="comment" class="form-label">Add Comment</label>
            <textarea
              class="form-control"
              name="review[comment]"
              id="comment"
              rows="5"
              cols="7"
              required
            ></textarea>
            <div class="d-flex justify-content-between mt-1 small text-muted">
              <span>Min 1 character</span>
              <span id="commentCount">0 / 500</span>
            </div>
          </div>
          <button class="btn btn-brand mb-3">Submit</button>
        </form>
        <hr />
        <% } else { %>
        <div
          class="alert alert-light border d-flex justify-content-between align-items-center"
        >
          <div>
            <b>Want to leave a review?</b>
            <span class="text-muted"
              >Please log in to share your experience.</span
            >
          </div>
          <div class="d-flex gap-2">
            <a class="btn btn-sm btn-outline-dark" href="/login">Log in</a>
            <a class="btn btn-sm btn-dark" href="/signup">Sign up</a>
          </div>
        </div>
        <% } %>

        <h4 class="mt-3">All Reviews</h4>
        <div class="row">
          <% for(review of list.reviews){ %>
          <div class="col-md-6">
            <div class="card mb-3">
              <div class="card-body">
                <h6 class="card-title mb-1"><%= review.author.username %></h6>
                <p
                  class="starability-result mb-2"
                  data-rating="<%= review.rating %>"
                ></p>
                <p class="card-text"><%= review.comment %></p>
                <form
                  method="post"
                  action="/listings/<%= list._id %>/reviews/<%= review._id %>?_method=DELETE"
                >
                  <button class="btn btn-sm btn-outline-dark">Delete</button>
                </form>
              </div>
            </div>
          </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</body>
