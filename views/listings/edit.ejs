<% layout("layouts/boilerplate") %>


  <form
    method="post"
    action="/listings/<%= list._id %>?_method=PUT"
    novalidate
    class="needs-validation"
    enctype="multipart/form-data"
  >
    <div class="row mt-3">
      <div class="col-8 offset-2">
        <h2>Edit Your Listing</h2>
        <br />
        <div class="mb-3">
          <label for="titile" class="form-label">Title: </label>
          <input
            class="form-control"
            value="<%= list.title %>"
            name="title"
            type="text"
            placeholder="enter title"
            required
          />
          <div class="valid-feedback">Title Looks Good</div>
          <div class="invalid-feedback">Please add title</div>
        </div>
        <div class="mb-3">
          <label for="description" class="form-label">Description: </label>
          <input
            class="form-control"
            value="<%= list.description %>"
            name="description"
            type="text"
            placeholder="enter description"
            required
          />
          <div class="invalid-feedback">Please enter short description</div>
        </div>
        <div class="mb-3 w-50">
            <img class="w-50" src="<%= list.image.url %>" alt="">
        </div>
        <div class="mb-3">
          <label for="image" class="form-label">Upload New Image </label>
          <input
            class="form-control"
            name="image"
            type="file"
          />
        <div class="row">
          <div class="mb-3 col-md-4">
            <label for="price" class="form-label">Price: </label>
            <input
              class="form-control"
              value="<%= list.price %>"
              name="price"
              type="number"
              placeholder="enter price"
              required
            />
            <div class="invalid-feedback">Please enter valid price</div>
          </div>

          <div class="mb-3 col-md-8">
            <label for="country" class="form-label">Country: </label>
            <input
              class="form-control"
              value="<%= list.country %>"
              name="country"
              type="text"
              placeholder="enter country"
              required
            />
            <div class="invalid-feedback">Please enter country</div>
          </div>
        </div>

        <div class="mb-3">
          <label for="location" class="form-label">Location: </label>
          <input
            class="form-control"
            value="<%= list.location %>"
            name="location"
            type="text"
            placeholder="enter location"
            required
          />
          <div class="invalid-feedback">Please enter location</div>
        </div>
        <br />
        <button class="btn btn-dark mb-5">Edit</button>
      </div>
    </div>
  </form>
